---
import BaseLayout from '../layouts/BaseLayout.astro';
const demoResources = [
	{ title: 'A small reading pile', type: 'Demo link collection', size: '—', description: 'A draft item for a future set of off-site reading links.', href: 'https://example.com/' },
	{ title: 'Loose image references', type: 'Demo external folder', size: '—', description: 'A visual test item; it does not point to a real shared folder.', href: 'https://example.com/' },
];
---
<BaseLayout title="Resources — pj2" description="A future directory for external resource links.">
	<main class="site-shell resources-page">
		<header class="masthead"><a class="masthead__mark" href="/" aria-label="pj2 home"><span class="masthead__dot" aria-hidden="true"></span><span>pj2 / 0.1</span></a><a class="masthead__link" href="/">Back home</a></header>
		<section class="resources-intro" aria-labelledby="resources-title"><p class="eyebrow">A future index of things living elsewhere</p><h1 id="resources-title">Resources.</h1><p>Not file hosting. Not a vault. Just a place to keep useful pointers toward external storage, folders, and links when the time comes.</p></section>
		<section aria-labelledby="demo-title"><div class="demo-heading flex items-baseline justify-between gap-4 py-4"><h2 id="demo-title">Demo entries only</h2><span class="text-signal-blue">V0.1 fixture data</span></div><ul class="grid gap-4 pt-4 m-0 list-none">{demoResources.map((resource, index) => (<li class:list={['resource-item grid items-center', index === 1 ? 'resource-item--blue bg-signal-blue text-white' : 'bg-signal-yellow']}><div class="resource-item__number self-start font-black" aria-hidden="true">0{index + 1}</div><div><p class="resource-item__meta mb-3 font-bold uppercase">{resource.type} · {resource.size}</p><h3>{resource.title}</h3><p>{resource.description}</p></div><a class="justify-self-end font-bold uppercase" href={resource.href} rel="external">Demo destination <span aria-hidden="true">↗</span></a></li>))}</ul></section>
		<p class="resource-boundary"><span class="text-signal-red" aria-hidden="true">✳</span> No upload, accounts, permission model, expiring link, or storage backend exists here yet.</p>
		<footer class="site-footer"><span>pj2 / resource shelf</span><a href="https://dansalways.top" rel="external">Elsewhere → dansalways</a></footer>
	</main>
	<style>
		.resources-page { padding-top: 1.2rem; }.eyebrow { margin: 0 0 1rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; }.resources-intro { max-width: 56rem; padding: clamp(4rem, 10vw, 9rem) 0 clamp(3rem, 7vw, 6rem); }h1 { margin: 0; font-size: clamp(4.5rem, 13vw, 13rem); font-weight: 900; letter-spacing: -0.11em; line-height: 0.72; color: var(--color-signal-red); }.resources-intro > p:last-child { max-width: 34rem; margin: clamp(2rem, 5vw, 4rem) 0 0 clamp(1rem, 13vw, 13rem); font-size: clamp(1rem, 1.6vw, 1.25rem); font-weight: 600; line-height: 1.35; }
		.demo-heading { border-top: 3px solid var(--color-ink); border-bottom: 1px solid var(--color-ink); }.demo-heading h2 { margin: 0; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; }.demo-heading span { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }.resource-item { grid-template-columns: auto minmax(0, 1fr) auto; gap: clamp(1rem, 4vw, 4rem); padding: clamp(1.3rem, 3vw, 2.4rem); border: 3px solid var(--color-ink); }.resource-item__number { font-size: clamp(2.4rem, 5vw, 5rem); line-height: 0.7; letter-spacing: -0.1em; }.resource-item__meta { font-size: 0.68rem; letter-spacing: 0.08em; }.resource-item h3 { margin: 0; font-size: clamp(1.6rem, 3vw, 3rem); font-weight: 900; letter-spacing: -0.06em; line-height: 0.9; }.resource-item p:last-child { max-width: 30rem; margin: 0.9rem 0 0; font-size: 0.95rem; font-weight: 600; line-height: 1.3; }.resource-item a { font-size: 0.75rem; letter-spacing: 0.06em; }.resource-item a:hover { color: var(--color-signal-red); }.resource-item--blue a:hover { color: var(--color-signal-yellow); }.resource-boundary { max-width: 42rem; margin: clamp(4rem, 9vw, 8rem) 0 0 auto; padding-left: 1.4rem; font-size: 0.9rem; font-weight: 700; line-height: 1.35; }.resource-boundary span { margin-left: -1.4rem; margin-right: 0.5rem; }
		@media (max-width: 650px) { .resource-item { grid-template-columns: auto 1fr; }.resource-item a { grid-column: 2; justify-self: start; } }@media (max-width: 430px) { h1 { font-size: clamp(4rem, 22vw, 6rem); }.resources-intro > p:last-child { margin-left: 0; }.resource-item { gap: 1rem; } }
	</style>
</BaseLayout>
